# Client-side Cloudinary
# Use an unsigned preset for the fastest browser upload path.
VITE_CLOUDINARY_CLOUD_NAME=demo
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional Supabase browser config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Vercel function secrets
# If these are set and /api/sign-cloudinary is reachable, the widget can use signed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
