# Client-side Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=demo
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional Supabase browser config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Vercel function secrets
# Used for signed uploads and Feature 1 Cloudinary transcription
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional transcription provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TRANSCRIPTION_MODEL=

# Shared workflow agent
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openai/gpt-5.4
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
AGENT_MEMORY_TABLE=agent_memories
VITE_ENABLE_WORKFLOW_AGENT=true

# Feature 2 AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_FALLBACK_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional smoke test credentials for authenticated UI coverage
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
